# Copie este arquivo para .env e coloque os dados do seu banco
DATABASE_URL=postgresql://postgres:sua_senha@localhost:5432/larflow

# Endereços do front que podem chamar a API (separados por vírgula)
CORS_ORIGIN=http://localhost:5173,https://lar-flow.vercel.app

# Chave que assina os tokens de login. Use um texto longo e aleatório e
# NUNCA coloque no GitHub. Para gerar uma:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# 1 = mostra erros detalhados (só em desenvolvimento)
FLASK_DEBUG=1
